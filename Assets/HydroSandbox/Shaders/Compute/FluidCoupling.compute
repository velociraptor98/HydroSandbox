// Samples the fluid around coupled rigid bodies, once per frame after the last substep. The CPU
// turns the results into buoyancy and drag (FluidRigidbodyCoupling).

#pragma kernel SampleFluid

#include "FluidGrid.hlsl"

StructuredBuffer<float4> _Positions;
StructuredBuffer<float4> _Velocities;
StructuredBuffer<float4> _Composition;
StructuredBuffer<float4> _SamplePoints;     // xyz world position

struct SampleResult
{
    float4 flow;        // xyz fluid velocity, w density / rest density
    float4 liquid;      // x mass density of the liquid there (kg/m^3; 0 for single-liquid scenes), y viscosity
};
RWStructuredBuffer<SampleResult> _SampleResults;
uint _SampleCount;

[numthreads(64, 1, 1)]
void SampleFluid(uint3 id : SV_DispatchThreadID)
{
    uint s = id.x;
    if (s >= _SampleCount)
        return;

    float3 x = _SamplePoints[s].xyz;
    float densitySum = 0;
    float3 velocitySum = 0;
    float4 compositionSum = 0;
    float weightSum = 0;
    FOR_EACH_GRID_NEIGHBOR(x, j)
        float3 r = x - _Positions[j].xyz;
        float r2 = dot(r, r);
        if (r2 >= _SmoothingRadiusSq)
            continue;
        float w = Poly6(r2);
        densitySum += w;
        velocitySum += _Velocities[j].xyz * w;
        if (_MultiFluid != 0)
            compositionSum += _Composition[j] * w;
        weightSum += w;
    END_FOR_EACH_GRID_NEIGHBOR

    float density = _ParticleMass * densitySum * _InvRestDensity;
    float3 velocity = weightSum > 0 ? velocitySum / weightSum : 0;
    float4 composition = weightSum > 0 ? compositionSum / weightSum : 0;
    SampleResult result;
    result.flow = float4(velocity, density);
    result.liquid = float4(dot(composition, _LiquidDensity), dot(composition, _LiquidViscosity), 0, 0);
    _SampleResults[s] = result;
}
