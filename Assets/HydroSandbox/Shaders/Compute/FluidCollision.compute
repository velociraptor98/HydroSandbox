// Collision response, run inside the solver loop (and once after prediction, before the
// neighbor search). Each kernel projects predicted positions out of one kind of obstacle and
// applies Coulomb-like friction to the tangential displacement relative to the obstacle surface.
// All of them run over the whole pool because the pre-sort pass happens before live particles
// are contiguous.

#pragma kernel ResolveContainer
#pragma kernel ResolveColliders
#pragma kernel ResolveTerrain
#pragma kernel ResolveTank

#include "FluidCommon.hlsl"

#define SHAPE_BOX 0
#define SHAPE_SPHERE 1
#define SHAPE_CAPSULE 2

struct ColliderRecord
{
    float3 center;
    uint shape;
    float4 rotation;        // world rotation quaternion (x, y, z, w)
    float3 extents;         // box half extents; capsule: (0, half segment length, 0)
    float radius;           // sphere and capsule radius
    float3 linearVelocity;
    uint padding;
    float3 angularVelocity;
    float friction;
};

RWStructuredBuffer<float4> _Predicted;
StructuredBuffer<float4> _Positions;
StructuredBuffer<float4> _Composition;

uint _ColliderCount;
StructuredBuffer<ColliderRecord> _Colliders;
// Collider records hold the end-of-frame pose; this substep's end is this many seconds earlier.
float _ColliderTimeOffset;
float _ParticleRadius;

// Heights normalized to [0, 1], row-major by z: index = z * resolution + x.
StructuredBuffer<float> _TerrainHeights;
float3 _TerrainOrigin;
float3 _TerrainSize;
uint _TerrainResolution;
float _TerrainFriction;

struct TankHole
{
    float3 center;          // on the wall's midplane
    float radius;
    uint wall;              // 0 = -X, 1 = +X, 2 = -Z, 3 = +Z
    uint3 padding;
};

// Open-topped glass tank: interior bounds, wall thickness, holes drilled in the side walls.
float3 _TankMin;
float3 _TankMax;
float _TankWall;
uint _TankHoleCount;
StructuredBuffer<TankHole> _TankHoles;

float3 RotateVector(float4 q, float3 v)
{
    float3 t = 2.0 * cross(q.xyz, v);
    return v + q.w * t + cross(q.xyz, t);
}

float3 InverseRotateVector(float4 q, float3 v)
{
    return RotateVector(float4(-q.xyz, q.w), v);
}

// Signed distance and outward normal, in the collider's local frame.
float ShapeDistance(ColliderRecord c, float3 p, out float3 normal)
{
    normal = float3(0, 1, 0);
    float distance;
    if (c.shape == SHAPE_SPHERE)
    {
        float len = length(p);
        if (len > 1e-6)
            normal = p / len;
        distance = len - c.radius;
    }
    else if (c.shape == SHAPE_CAPSULE)
    {
        float3 v = p - float3(0, clamp(p.y, -c.extents.y, c.extents.y), 0);
        float len = length(v);
        normal = len > 1e-6 ? v / len : float3(1, 0, 0);
        distance = len - c.radius;
    }
    else
    {
        float3 q = abs(p) - c.extents;
        float3 outside = max(q, 0);
        float outsideLen = length(outside);
        if (outsideLen > 0)
        {
            normal = outside / outsideLen * sign(p);
            distance = outsideLen;
        }
        else
        {
            // Inside: leave through the nearest face.
            if (q.x >= q.y && q.x >= q.z)
                normal = float3(sign(p.x), 0, 0);
            else if (q.y >= q.z)
                normal = float3(0, sign(p.y), 0);
            else
                normal = float3(0, 0, sign(p.z));
            distance = max(q.x, max(q.y, q.z));
        }
    }
    return distance;
}

// Pushes p out to the particle radius along `normal` and removes `friction` of its tangential
// displacement relative to a surface moving at surfaceVelocity. Returns the correction.
float3 Contact(float3 p, float3 previous, float3 normal, float distance, float3 surfaceVelocity, float friction)
{
    float3 correction = normal * (_ParticleRadius - distance);
    float3 slip = (p + correction) - previous - surfaceVelocity * _DeltaTime;
    float3 tangential = slip - dot(slip, normal) * normal;
    return correction - tangential * friction;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void ResolveContainer(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount)
        return;
    float4 p = _Predicted[i];
    if (!IsAlive(p))
        return;

    // _ContainerMin/_ContainerMax are already inset by the particle radius.
    float3 clamped = clamp(p.xyz, _ContainerMin, _ContainerMax);
    if (_MultiFluid != 0)
    {
        // Wall friction on the axes not being pushed; pulling toward the previous (inside)
        // position cannot leave the box.
        float3 hit = float3(clamped != p.xyz);
        if (any(hit))
        {
            float friction = dot(_Composition[i], _LiquidWallFriction);
            clamped -= (clamped - _Positions[i].xyz) * (1.0 - hit) * friction;
        }
    }
    _Predicted[i] = float4(clamped, p.w);
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void ResolveColliders(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount)
        return;
    float4 p4 = _Predicted[i];
    if (!IsAlive(p4))
        return;

    float3 p = p4.xyz;
    float3 previous = _Positions[i].xyz;
    bool moved = false;
    for (uint k = 0; k < _ColliderCount; k++)
    {
        ColliderRecord c = _Colliders[k];
        // A collider moving more than its own thickness in one frame would otherwise jump past
        // the particles in its way and push them out of its far side.
        c.center -= c.linearVelocity * _ColliderTimeOffset;
        float3 localNormal;
        float distance = ShapeDistance(c, InverseRotateVector(c.rotation, p - c.center), localNormal);
        if (distance >= _ParticleRadius)
            continue;

        float3 normal = RotateVector(c.rotation, localNormal);
        float3 contactPoint = p - normal * distance;
        float3 surfaceVelocity = c.linearVelocity + cross(c.angularVelocity, contactPoint - c.center);
        p += Contact(p, previous, normal, distance, surfaceVelocity, c.friction);
        moved = true;
    }
    if (moved)
        _Predicted[i] = float4(p, p4.w);
}

float TerrainHeight(float2 cell)
{
    uint res = _TerrainResolution;
    cell = clamp(cell, 0, res - 1.001);
    uint2 c0 = (uint2)cell;
    float2 f = cell - c0;
    float h00 = _TerrainHeights[c0.y * res + c0.x];
    float h10 = _TerrainHeights[c0.y * res + c0.x + 1];
    float h01 = _TerrainHeights[(c0.y + 1) * res + c0.x];
    float h11 = _TerrainHeights[(c0.y + 1) * res + c0.x + 1];
    return lerp(lerp(h00, h10, f.x), lerp(h01, h11, f.x), f.y) * _TerrainSize.y + _TerrainOrigin.y;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void ResolveTerrain(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount || _TerrainResolution == 0)
        return;
    float4 p4 = _Predicted[i];
    if (!IsAlive(p4))
        return;

    float3 p = p4.xyz;
    float2 uv = (p.xz - _TerrainOrigin.xz) / _TerrainSize.xz;
    if (any(uv < 0.0) || any(uv > 1.0))
        return;

    float2 cellSize = _TerrainSize.xz / (_TerrainResolution - 1);
    float2 cell = uv * (_TerrainResolution - 1);
    float h = TerrainHeight(cell);
    // Cheap reject before the gradient: anything clearly above the surface plus a steep bank.
    if (p.y - h > _ParticleRadius * 4.0)
        return;

    float dhdx = (TerrainHeight(cell + float2(1, 0)) - TerrainHeight(cell - float2(1, 0))) / (2.0 * cellSize.x);
    float dhdz = (TerrainHeight(cell + float2(0, 1)) - TerrainHeight(cell - float2(0, 1))) / (2.0 * cellSize.y);
    float3 normal = normalize(float3(-dhdx, 1.0, -dhdz));
    // Distance to the local tangent plane of the heightfield.
    float distance = (p.y - h) * normal.y;
    if (distance >= _ParticleRadius)
        return;

    p += Contact(p, _Positions[i].xyz, normal, distance, 0, _TerrainFriction);
    _Predicted[i] = float4(p, p4.w);
}

// Wall slabs as boxes. The side walls reach from under the floor to the rim, and overlap at the
// corners. Wall 4 is the floor.
void TankWall(uint wall, out float3 center, out float3 extents, out float3 axis)
{
    float t = _TankWall;
    float3 lo = float3(_TankMin.x - t, _TankMin.y - t, _TankMin.z - t);
    float3 hi = float3(_TankMax.x + t, _TankMax.y, _TankMax.z + t);
    if (wall == 4)
    {
        axis = float3(0, 1, 0);
        hi.y = _TankMin.y;
    }
    else if (wall < 2)
    {
        axis = float3(1, 0, 0);
        if (wall == 0) hi.x = _TankMin.x; else lo.x = _TankMax.x;
    }
    else
    {
        axis = float3(0, 0, 1);
        if (wall == 2) hi.z = _TankMin.z; else lo.z = _TankMax.z;
    }
    center = (lo + hi) * 0.5;
    extents = (hi - lo) * 0.5;
}

// Signed distance to a wall slab. The glass is about as thin as a particle, so a particle found
// inside it leaves on the side it came from (its position at the start of the substep), not the
// nearest one: otherwise a fast particle would be pushed through.
float SlabDistance(float3 p, float3 previous, float3 center, float3 extents, out float3 normal)
{
    float3 local = p - center;
    float3 q = abs(local) - extents;
    float3 outside = max(q, 0);
    float outsideLen = length(outside);
    if (outsideLen > 0)
    {
        normal = outside / outsideLen * sign(local);
        return outsideLen;
    }

    float3 prevLocal = previous - center;
    float3 prevQ = abs(prevLocal) - extents;
    float3 exitQ = prevQ;
    float3 side = sign(prevLocal);
    if (max(prevQ.x, max(prevQ.y, prevQ.z)) <= 0)
    {
        exitQ = q;
        side = sign(local);
    }
    float3 k = exitQ.x >= exitQ.y && exitQ.x >= exitQ.z ? float3(1, 0, 0) : (exitQ.y >= exitQ.z ? float3(0, 1, 0) : float3(0, 0, 1));
    float s = dot(side, k);
    s = s != 0 ? s : 1.0;
    normal = k * s;
    return s * dot(local, k) - dot(extents, k);
}

// The tank is solid glass minus the drilled holes: per wall, max(slab, radius - distance from
// the hole's axis), which near a hole's rim gives the bore as the nearest surface. Liquid that
// gets out falls on whatever else is in the solver's container.
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void ResolveTank(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount)
        return;
    float4 p4 = _Predicted[i];
    if (!IsAlive(p4))
        return;

    float3 p = p4.xyz;
    float r = _ParticleRadius;
    float t = _TankWall;
    float3 outerMin = _TankMin - t - r;
    float3 outerMax = float3(_TankMax.x + t, _TankMax.y, _TankMax.z + t) + r;
    if (any(p < outerMin) || any(p > outerMax))
        return;
    if (all(p > _TankMin + r) && all(p.xz < _TankMax.xz - r))
        return;

    float3 previous = _Positions[i].xyz;
    float friction = _MultiFluid != 0 ? dot(_Composition[i], _LiquidWallFriction) : 0.0;
    for (uint wall = 0; wall < 5; wall++)
    {
        float3 center, extents;
        float3 axis;
        TankWall(wall, center, extents, axis);
        float3 normal;
        float distance = SlabDistance(p, previous, center, extents, normal);

        float bore = -1e9;
        float3 boreNormal = 0;
        for (uint h = 0; h < _TankHoleCount; h++)
        {
            TankHole hole = _TankHoles[h];
            if (hole.wall != wall)
                continue;
            float3 d = p - hole.center;
            d -= dot(d, axis) * axis;
            float rho = length(d);
            float b = hole.radius - rho;
            if (b > bore)
            {
                bore = b;
                boreNormal = rho > 1e-6 ? -d / rho : 0;
            }
        }
        if (bore > 0 && distance > 0)
        {
            normal = normalize(distance * normal + bore * boreNormal);
            distance = length(float2(distance, bore));
        }
        else if (bore > distance)
        {
            normal = boreNormal;
            distance = bore;
        }

        if (distance < r && any(normal != 0))
            p += Contact(p, previous, normal, distance, 0, friction);
    }
    _Predicted[i] = float4(p, p4.w);
}
