#pragma kernel Predict

#include "FluidCommon.hlsl"

StructuredBuffer<float4> _Positions;
StructuredBuffer<float> _Density;
RWStructuredBuffer<float4> _Velocities;
RWStructuredBuffer<float4> _Predicted;

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void Predict(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount)
        return;
    float4 p = _Positions[i];
    if (!IsAlive(p))
        return;

    float4 velocity = _Velocities[i];
    // Entrained air makes submerged aerated water lighter, so plunged bubbles rise back up.
    // _Density is from the previous substep, in the same (unsorted since) particle order.
    float buoyancy = velocity.w * _AerationBuoyancy * Submersion(_Density[i]);
    float3 v = velocity.xyz + _Gravity * ((1.0 - buoyancy) * _DeltaTime);
    _Velocities[i] = float4(v, velocity.w);
    _Predicted[i] = float4(p.xyz + v * _DeltaTime, p.w);
}
